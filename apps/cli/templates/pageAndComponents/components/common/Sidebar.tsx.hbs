"use client";

import React from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import {
	LayoutDashboard,
	Settings,
	CreditCard,
	BarChart3,
	Lock,
	AlertTriangle,
} from "lucide-react";
import { cn } from "../../lib/utils";

const navigation = [
	{
		name: "Dashboard",
		href: "/dashboard",
		icon: LayoutDashboard,
		show: true, // Always show
	},
	{{#if (eq analytics "none")}}
	{
		name: "Analytics",
		href: "/dashboard/analytics",
		icon: BarChart3,
		show: false, // Not available
		disabled: true,
	},
	{{/if}}
	{{#unless (eq analytics "none")}}
	{
		name: "Analytics",
		href: "/dashboard/analytics",
		icon: BarChart3,
		show: true,
	},
	{{/unless}}
	{{#if (eq payment "none")}}
	{
		name: "Billing",
		href: "/dashboard/billing",
		icon: CreditCard,
		show: false, // Not available
		disabled: true,
	},
	{{/if}}
	{{#unless (eq payment "none")}}
	{
		name: "Billing",
		href: "/dashboard/billing",
		icon: CreditCard,
		show: true,
	},
	{{/unless}}
	{
		name: "Settings",
		href: "/dashboard/settings",
		icon: Settings,
		show: true, // Always show
	},
	{{#if (eq auth "none")}}
	{
		name: "Authentication",
		href: "/dashboard/auth",
		icon: Lock,
		show: false, // Not available
		disabled: true,
	},
	{{/if}}
	{{#unless (eq auth "none")}}
	{
		name: "Authentication",
		href: "/dashboard/auth",
		icon: Lock,
		show: true,
	},
	{{/unless}}
];

export default function Sidebar() {
	const pathname = usePathname();

	return (
		<div className="flex h-full w-64 flex-col fixed inset-y-0">
			<div className="flex flex-1 flex-col min-h-0 border-r border-gray-200 bg-white">
				<div className="flex-1 flex flex-col pt-5 pb-4 overflow-y-auto">
					{{#if (eq auth "none")}}
					<div className="px-3 mb-4">
						<div className="flex items-center p-2 bg-yellow-50 border border-yellow-200 rounded-md">
							<AlertTriangle className="h-4 w-4 text-yellow-600 mr-2" />
							<span className="text-xs text-yellow-800">Public navigation</span>
						</div>
					</div>
					{{/if}}
					<nav className="mt-5 flex-1 px-2 space-y-1">
						{navigation.map((item) => {
							const isActive = pathname === item.href;
							const Icon = item.icon;
							
							return (
								<Link
									key={item.name}
									href={item.disabled ? "#" : item.href}
									className={cn(
										isActive
											? "bg-gray-100 text-gray-900"
											: "text-gray-600 hover:bg-gray-50 hover:text-gray-900",
										item.disabled
											? "opacity-50 cursor-not-allowed"
											: "cursor-pointer",
										"group flex items-center px-2 py-2 text-sm font-medium rounded-md"
									)}
									onClick={item.disabled ? (e) => e.preventDefault() : undefined}
								>
									<Icon
										className={cn(
											isActive ? "text-gray-500" : "text-gray-400 group-hover:text-gray-500",
											"mr-3 flex-shrink-0 h-6 w-6"
										)}
									/>
									{item.name}
									{item.disabled && (
										<span className="ml-auto text-xs text-gray-400">(N/A)</span>
									)}
								</Link>
							);
						})}
					</nav>
				</div>
			</div>
		</div>
	);
} 